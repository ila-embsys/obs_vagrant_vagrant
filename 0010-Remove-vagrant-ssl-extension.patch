From 1e7cb9f717267ef178d4786aa65a989f4099804a Mon Sep 17 00:00:00 2001
From: Georg Pfuetzenreuter <georg.pfuetzenreuter@suse.com>
Date: Thu, 16 Nov 2023 13:50:07 +0100
Subject: [PATCH 10/12] Remove vagrant ssl extension

---
 Rakefile        | 4 ----
 vagrant.gemspec | 2 --
 2 files changed, 6 deletions(-)

diff --git a/Rakefile b/Rakefile
index b2f594b00..2af398a1e 100644
--- a/Rakefile
+++ b/Rakefile
@@ -1,15 +1,11 @@
 require 'rubygems'
 require 'bundler/setup'
-require "rake/extensiontask"
 
 # Immediately sync all stdout so that tools like buildbot can
 # immediately load in the output.
 $stdout.sync = true
 $stderr.sync = true
 
-Rake::ExtensionTask.new "vagrant/vagrant_ssl" do |ext|
-end
-
 # Load all the rake tasks from the "tasks" folder. This folder
 # allows us to nicely separate rake tasks into individual files
 # based on their role, which makes development and debugging easier
diff --git a/vagrant.gemspec b/vagrant.gemspec
index 0fe49dea5..8e5701e9b 100644
--- a/vagrant.gemspec
+++ b/vagrant.gemspec
@@ -48,7 +48,6 @@ Gem::Specification.new do |s|
   # Constraint rake to properly handle deprecated method usage
   # from within rspec
   s.add_development_dependency "rake", "~> 13.0"
-  s.add_development_dependency "rake-compiler"
   s.add_development_dependency "rspec", "~> 3.11"
   s.add_development_dependency "rspec-its", "~> 1.3.0"
   s.add_development_dependency "fake_ftp", "~> 0.3.0"
@@ -104,6 +103,5 @@ Gem::Specification.new do |s|
 
   s.files         = unignored_files
   s.executables   = unignored_files.map { |f| f[/^bin\/(.*)/, 1] }.compact
-  s.extensions    = ["ext/vagrant/vagrant_ssl/extconf.rb"]
   s.require_path  = 'lib'
 end
-- 
